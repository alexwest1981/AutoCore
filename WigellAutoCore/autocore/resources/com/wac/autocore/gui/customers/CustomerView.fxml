<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.*?>
<?import java.util.*?>
<?import javafx.scene.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.TableView?>

<VBox xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.wac.autocore.gui.customers.CustomerController"
            prefHeight="400.0" prefWidth="600.0">
<Label text="Kunder"/>
    <TableView fx:id="customerListView">
        <columns>
            <TableColumn fx:id="customerIdColumn" text="Id"/>
            <TableColumn fx:id="customerNameColumn" text="Name"/>
            <TableColumn fx:id="customerPhoneColumn" text="Phone"/>
            <TableColumn fx:id="customerEmailColumn" text="Email"/>
        </columns>
    </TableView>

    <TextField fx:id="nameField" promptText="Name"/>
    <TextField fx:id="phoneField" promptText="Phone"/>
    <TextField fx:id="emailField" promptText="Email"/>

    <Button text="Save customer" onAction="#handleCreateCustomer"/>
    <Label fx:id="statusLabel"/>

</VBox>
