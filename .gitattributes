# Auto-detect all text files and normalise line endings
* text=auto

# Source code, scripts and configuration files always use Unix line endings (LF)
*.sh text eol=lf
*.java text eol=lf
*.json text eol=lf
*.xml text eol=lf
*.css text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.properties text eol=lf
*.gitignore text eol=lf
*.gitattributes text eol=lf
*.yml text eol=lf
*.yaml text eol=lf

# Windows script files use Windows line endings (CRLF)
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary files are never touched by Git
*.jar binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.db binary
*.class binary
